{
  "name": "safe-write-mode",
  "version": "0.2.2",
  "description": "Read-only by default. Three-key write protection. Auditable by design. Pattern for letting agents and scripts safely interact with live external systems.",
  "main": "src/index.js",
  "types": "index.d.ts",
  "files": [
    "src/",
    "index.d.ts",
    "adapters/",
    "checklists/",
    "docs/",
    "examples/",
    "CHANGELOG.md",
    "SKILL.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "SAFE_WRITE_TEST_HOOKS=1 node --test 'test/*.test.js'",
    "prepublishOnly": "SAFE_WRITE_TEST_HOOKS=1 node --test 'test/*.test.js'",
    "example:basic": "node examples/basic-read-only.js",
    "example:write": "SAFE_WRITE_MODE=read-write node examples/three-key-write.js",
    "example:dry-run": "SAFE_WRITE_MODE=read-write node examples/dry-run-flow.js",
    "example:multi-tenant": "node examples/multi-tenant.js",
    "example:agent": "node examples/agent-tool.js get SKU-42"
  },
  "keywords": [
    "safety",
    "guardrail",
    "agent",
    "ai",
    "audit",
    "read-only",
    "write-protection",
    "live-system",
    "operator-tools",
    "claude",
    "llm"
  ],
  "author": "Max Schottke <max.schottke@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maxschottke-spec/safe-write-mode.git"
  },
  "bugs": {
    "url": "https://github.com/maxschottke-spec/safe-write-mode/issues"
  },
  "homepage": "https://github.com/maxschottke-spec/safe-write-mode#readme",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
