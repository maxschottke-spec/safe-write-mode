# Example configuration for safe-write-mode.
#
# The library does NOT load this file. It only reads process.env. Either export
# the variables in your shell, or copy this file to .env and start Node with it:
#
#   node --env-file=.env your-script.js
#
# .env is in .gitignore. Never commit real tokens.

# Leave the mode out of this file. The default is read-only, and switching to
# read-write should be a deliberate act for one command:
#   SAFE_WRITE_MODE=read-write node --env-file=.env your-script.js
# SAFE_WRITE_MODE=read-only

# Directory of the audit log (default: ./logs). If it is not writable, every
# write is refused.
WRITE_LOG_DIR=./logs

# Make a non-empty `reason` mandatory for every write.
SAFE_WRITE_REQUIRE_REASON=1

# Console log on stderr: error, warn, info (default) or debug.
LOG_LEVEL=warn

# Optional. Key for `targetHash` in the audit log, so entries can be matched
# across runs. Read once at load, then removed from process.env.
# SAFE_WRITE_AUDIT_KEY=replace-with-a-long-random-string

# Only for the bundled request() helper, and rarely needed:
# SAFE_WRITE_ALLOW_INSECURE=1    # allow http: (private addresses stay blocked)
# SAFE_WRITE_SKIP_DNS_CHECK=1    # skip the DNS lookup of the SSRF guard

# Your own credentials go here too, for example:
# ERP_API_TOKEN=
